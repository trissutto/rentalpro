# ─── BANCO DE DADOS ─────────────────────────────────────────────
# SQLite em arquivo. O caminho é o que muda entre os ambientes:
#   local    → file:./dev.db
#   Railway  → file:/app/prisma/dev.db   (volume montado em /app/prisma)
DATABASE_URL="file:./dev.db"

# ─── AUTENTICAÇÃO ────────────────────────────────────────────────
# Chave secreta JWT (mude em produção!)
JWT_SECRET=""
# Opcional: chave separada para links dos hóspedes; se vazia, usa JWT_SECRET.
GUEST_ACCESS_SECRET=""

# ─── WHATSAPP (OPCIONAL) ─────────────────────────────────────────
# Evolution API (recomendado) ou Z-API
WHATSAPP_API_URL="https://api.seudominio.com"
WHATSAPP_API_KEY="sua-chave-api"
WHATSAPP_INSTANCE="rental-instance"

# ─── CRON / ROTAS ADMIN ──────────────────────────────────────────
# OBRIGATÓRIA. Protege /api/cron/* e /api/admin/sync-airbnb-content.
# Sem ela essas rotas respondem 503 (não há valor padrão no código).
# Gere com: openssl rand -hex 20
CRON_SECRET=""

# ─── NEXT.JS ─────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# ─── UPLOAD DE IMAGENS (OPCIONAL) ───────────────────────────────
# Cloudinary para fotos dos imóveis
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
